# ==============================================================================
# SmartFix AI — Environment Configuration Matrix
# ==============================================================================
# Copy this file to .env.production (or set environment variables in your
# AWS Lambda / ECS / Systemd environment). Do NOT commit secrets to git.

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vite / React)
# ------------------------------------------------------------------------------
# In production, set to your live Amazon API Gateway stage URL or CloudFront API domain.
# In local development, leave empty to automatically proxy via Vite to http://127.0.0.1:8000
VITE_API_BASE_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/production

# Optional: Remote Cognito User Pool Client Configuration (if authenticating directly from SPA)
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=us-east-1

# ------------------------------------------------------------------------------
# 2. BACKEND RUNTIME & SECURITY CONFIGURATION (Python Backend / Lambda)
# ------------------------------------------------------------------------------
# Required environment designation ('production' | 'staging' | 'development')
ENVIRONMENT=production

# Storage Backend: In production, strictly set to 'dynamodb'. Local file storage is rejected at startup.
DATA_BACKEND=dynamodb

# Amazon DynamoDB Configuration
DYNAMODB_TABLE_NAME=SmartFix-Production-core-table
AWS_REGION=us-east-1

# Amazon S3 Private Attachment Storage
S3_BUCKET_NAME=smartfix-production-attachments-123456789012
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_BYTES=5242880

# Amazon Cognito Multi-Tenant Verification
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1

# CORS & Cookie Security Configuration
# Explicit, comma-separated HTTPS origins. Wildcard ('*') and insecure HTTP origins are rejected in production.
ALLOWED_ORIGINS=https://campus.edu,https://admin.campus.edu

# Fallback JWT Signing Secret (Minimum 64 characters; used for internal local token signing)
JWT_SECRET=super_secret_64_char_random_cryptographic_key_hex_value_for_production_only!

# ------------------------------------------------------------------------------
# 3. AI & RAG SERVICE PROVIDERS (Server-side Only)
# ------------------------------------------------------------------------------
# Google Gemini API key for multimodal vision fault classification
GEMINI_API_KEY=AIzaSyYourProductionGeminiKeyHere

# Pinecone Vector Database for historical verified repair retrieval
PINECONE_API_KEY=pcsk_YourProductionPineconeKeyHere
PINECONE_INDEX_NAME=smartfix-campus-repairs
